# ========================================
# QOLQA Backend - Environment Variables
# ========================================
# Copy this file to .env and configure with your values
# DO NOT commit .env file to git!

# Environment (development, staging, production)
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/qolqa_db
TYPE_DB=mongo

# JWT Security Settings
# CRITICAL: Generate a secure secret key for production!
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-CHANGE-THIS-IN-PRODUCTION-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300

# CORS Settings
# Comma-separated list of allowed origins
# Development example:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production example:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Debug Mode (only for development)
DEBUG=false

# Google OAuth — GOOGLE_CLIENT_ID=

# Database timeout (seconds)
DB_OPERATION_TIMEOUT=10

# Request body size limit (bytes)
# Default: 5MB = 5000000 bytes
# For larger file uploads, increase this value
MAX_REQUEST_BODY_SIZE=5000000

# ========================================
# PRODUCTION SECURITY CHECKLIST
# ========================================
# Before deploying to production, ensure:
# 
# 1. ✅ Set ENVIRONMENT=production
# 2. ✅ Generate a NEW SECRET_KEY (not the default!)
#    Command: openssl rand -hex 32
# 3. ✅ Set specific ALLOWED_ORIGINS (not localhost!)
# 4. ✅ Set DEBUG=false
# 5. ✅ Use secure DATABASE_URL (with authentication)
# 6. ✅ Enable HTTPS/TLS on your server
# 7. ✅ Review and test all security headers
# 8. ✅ Set up proper logging and monitoring
# ========================================
